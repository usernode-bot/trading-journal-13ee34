{
  "secrets": [],
  "tests": [
    {
      "id": "home.logo",
      "name": "Header shows the app logo",
      "path": "/",
      "expectSelector": "header img[src='/logo.svg']",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/logo.svg"
      ]
    },
    {
      "name": "Empty journal offers the first trade",
      "path": "/",
      "expectText": "Belum ada trade"
    },
    {
      "id": "journal.discipline",
      "name": "Trade list shows risk, RR and discipline badges",
      "path": "/?demo=1",
      "expectText": "❌ Melanggar",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "styles/**"
      ]
    },
    {
      "name": "Disciplined demo trade gets a check badge",
      "path": "/?demo=1",
      "expectText": "✅ Disiplin"
    },
    {
      "name": "Empty journal summary shows dashes",
      "path": "/",
      "expectText": "Ringkasan"
    },
    {
      "id": "journal.summary",
      "name": "Summary shows win rate and max drawdown",
      "path": "/?demo=1",
      "expectText": "5,88% dari modal puncak",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "id": "journal.import",
      "name": "Journal offers CSV import",
      "path": "/",
      "expectSelector": "#import-btn",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/contoh-impor.csv",
        "server.js",
        "styles/**"
      ]
    },
    {
      "name": "Empty journal offers CSV import",
      "path": "/",
      "expectText": "Impor dari CSV"
    },
    {
      "id": "nav.bottom",
      "name": "Bottom navigation shows the four tabs",
      "path": "/",
      "expectSelector": "#tab-sinyal",
      "visual": true,
      "impact": [
        "public/index.html",
        "styles/**",
        "tailwind.config.js"
      ]
    },
    {
      "name": "Disclaimer footer tampil",
      "path": "/",
      "expectText": "Trading berisiko tinggi"
    },
    {
      "name": "Kalkulator lot tersedia di jurnal kosong",
      "path": "/",
      "expectText": "Kalkulator lot & risiko"
    },
    {
      "id": "journal.equity",
      "name": "Summary shows the equity chart from 2 trades",
      "path": "/?demo=1",
      "expectSelector": "#equity-chart svg",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "Rekap per kategori tampil",
      "path": "/?demo=1",
      "expectText": "Performa per kategori"
    },
    {
      "name": "Jurnal menawarkan ekspor CSV",
      "path": "/?demo=1",
      "expectSelector": "#export-btn"
    },
    {
      "id": "broker.cards",
      "name": "Broker tab shows the Exness affiliate card",
      "path": "/#/broker",
      "expectText": "Link afiliasi",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "name": "Sinyal terkunci untuk pengguna Gratis",
      "path": "/#/sinyal",
      "expectText": "Daftar VIP"
    },
    {
      "id": "vip.form",
      "name": "VIP tab shows the signup form and contact card",
      "path": "/#/vip",
      "expectText": "Hubungi admin",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
