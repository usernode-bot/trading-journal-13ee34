  },
  "tests": [
    {
      "name": "Jurnal header has the overflow menu",
      "path": "/#/jurnal",
      "expectSelector": "#more-btn[aria-haspopup='menu']"
    },
    {
      "id": "home.logo",
      "name": "Header shows the app logo",
      "path": "/",
      "expectSelector": "header img[src='/logo.svg']",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/logo.svg",
        "brand/icon.svg",
        "brand/icon.png"
      ]
    },
    {
      "name": "Empty journal offers the first trade",
      "path": "/",
      "expectText": "Belum ada trade"
    },
    {
      "name": "Language selector is available",
      "path": "/",
      "expectSelector": "#lang-select"
    },
    {
      "id": "i18n.english",
      "name": "English UI via the language override",
      "path": "/?lang=en",
      "expectText": "No trades yet",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/i18n.js",
        "server.js"
      ]
    },
    {
      "name": "Discipline badges switch to English",
