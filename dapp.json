{
  "secrets": [],
  "tests": [
    {
      "id": "home.logo",
      "name": "Header shows the app logo",
      "path": "/",
      "expectSelector": "header img[src='/logo.svg']",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/logo.svg"
      ]
    },
    {
      "name": "Empty journal offers the first trade",
      "path": "/",
      "expectText": "Belum ada trade"
    },
    {
      "id": "journal.discipline",
      "name": "Trade list shows risk, RR and discipline badges",
      "path": "/?demo=1",
      "expectText": "❌ Melanggar",
      "visual": true,
      "impact": [
        "public/index.html",
        "server.js",
        "styles/**"
      ]
    },
    {
      "name": "Disciplined demo trade gets a check badge",
      "path": "/?demo=1",
      "expectText": "✅ Disiplin"
    },
    {
      "name": "Empty journal summary shows dashes",
      "path": "/",
      "expectText": "Ringkasan"
    },
    {
      "id": "journal.summary",
      "name": "Summary shows win rate and max drawdown",
      "path": "/?demo=1",
      "expectText": "5,88% dari modal puncak",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "id": "journal.import",
      "name": "Journal offers CSV import",
      "path": "/",
      "expectSelector": "#import-btn",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/contoh-impor.csv",
        "server.js",
        "styles/**"
      ]
    },
    {
      "name": "Empty journal offers CSV import",
      "path": "/",
      "expectText": "Impor dari CSV"
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
